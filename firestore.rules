rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ALLOW ANYONE TO READ GLOBAL DEFAULTS
    match /public_assets/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.email == 'plasticarm@gmail.com';
    }
    
    // ALLOW USERS TO MANAGE THEIR OWN SESSIONS
    match /sessions/{sessionId} {
      // For queries, we check if the userId field matches the authenticated user
      // For direct gets, we check the same
      allow read: if isAuthenticated() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (resource == null) // Allow checking for existence
      );
      
      // Allow create/update if the incoming data belongs to the user
      allow write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Allow delete if the user owns the document
      allow delete: if isAuthenticated() && resource != null && resource.data.userId == request.auth.uid;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
